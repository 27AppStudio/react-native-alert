<?xml version="1.0" encoding="utf-8"?>
<!-- The prompt's text field: an outlined Material 3 field, inset like the dialog's
     title and message. The tag is the field's testID for Detox and Appium. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="?attr/dialogPreferredPadding"
    android:paddingTop="8dp"
    android:paddingEnd="?attr/dialogPreferredPadding">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/rnalert_prompt_layout"
        style="?attr/textInputOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/rnalert_prompt_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1"
            android:tag="rn-alert-prompt-input" />
    </com.google.android.material.textfield.TextInputLayout>
</FrameLayout>
